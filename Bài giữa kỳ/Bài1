<?php
require_once __DIR__ . "/common/auth.php";

$name = "";
$score = "";
$result = "";
$error = "";

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $name = trim($_POST["name"] ?? "");
    $score = $_POST["score"] ?? "";

    if ($name === "" || $score === "" || !is_numeric($score)
        || $score < 0 || $score > 10) {
        $error = "Vui lòng nhập tên và điểm hợp lệ (0–10).";
    } else {
        $score = (float) $score;

        if ($score >= 8) {
            $result = "Giỏi";
        } elseif ($score >= 6.5) {
            $result = "Khá";
        } elseif ($score >= 5) {
            $result = "Trung bình";
        } else {
            $result = "Yếu";
        }
    }
}

require_once __DIR__ . "/view/header.php";
?>

<h1>Xếp loại học sinh</h1>

<?php if ($error !== ""): ?>
    <p style="color: red;">
        <?= htmlspecialchars($error, ENT_QUOTES, "UTF-8") ?>
    </p>
<?php endif; ?>

<form method="POST" action="">
    <p>
        <label for="name">Tên học sinh:</label><br>
        <input
            type="text"
            id="name"
            name="name"
            value="<?= htmlspecialchars($name, ENT_QUOTES, "UTF-8") ?>"
            required
        >
    </p>

    <p>
        <label for="score">Điểm:</label><br>
        <input
            type="number"
            id="score"
            name="score"
            min="0"
            max="10"
            step="0.1"
            value="<?= htmlspecialchars((string) $score, ENT_QUOTES, "UTF-8") ?>"
            required
        >
    </p>

    <button type="submit">Xếp loại</button>
</form>

<?php if ($result !== ""): ?>
    <h2>Kết quả học tập</h2>
    <p>
        Tên học sinh:
        <?= htmlspecialchars($name, ENT_QUOTES, "UTF-8") ?>
    </p>
    <p>
        Điểm: <?= htmlspecialchars((string) $score, ENT_QUOTES, "UTF-8") ?>
    </p>
    <p>
        Xếp loại: <?= htmlspecialchars($result, ENT_QUOTES, "UTF-8") ?>
    </p>
<?php endif; ?>

<?php require_once __DIR__ . "/view/footer.php"; ?>
